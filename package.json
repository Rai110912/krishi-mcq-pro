{
  "name": "krishi-mcq-pro",
  "version": "1.0.0",
  "description": "Premium 3D Nepal Civil Service Agriculture Preparation PWA Platform",
  "main": "js/app.js",
  "scripts": {
    "sync-assets": "node sync-assets.js",
    "build": "npm run sync-assets",
    "capacitor:init": "npx cap init \"Krishi MCQ Pro\" \"com.krishimcqpro.app\" --web-dir=.",
    "capacitor:add-android": "npx cap add android",
    "capacitor:sync": "npm run sync-assets && npx cap sync"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/status-bar": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1"
  }
}
