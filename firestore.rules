rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sync_keys/{key} {
      allow read, write: if true;
      
      match /{document=**} {
        allow read, write, delete: if true;
      }
    }
    match /sync_pins/{pin} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
      
      match /{document=**} {
        allow read, write, delete: if true;
      }
    }
  }
}
