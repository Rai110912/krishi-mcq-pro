rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User Data: Only authenticated owner can access ───────────────────────
    // All user progress, bookmarks, mistakes, stats, sessions, backups, handoff
    // are stored under users/{userId}/...
    // A user can ONLY read/write their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /{document=**} {
        allow read, write, delete: if request.auth != null
                                   && request.auth.uid == userId;
      }
    }

    // ─── Pairing Pins: Short-lived, owner-controlled ─────────────────────────
    // Pins are 6-digit codes (15-minute validity) used to link a second device.
    //   - CREATE: only the authenticated creator, who must stamp their own UID
    //     as ownerUid. Overwriting someone else's existing pin via set()
    //     fails because an existing doc evaluates against the update rule.
    //   - GET: any authenticated user may fetch a specific pin by ID (required
    //     for pairing), but expired pins become unreadable server-side, which
    //     bounds the exposure window of the embedded sync key.
    //   - LIST: denied — pins must be known by ID, so the collection cannot be
    //     enumerated to discover other users' pairing attempts.
    //   - UPDATE/DELETE: owner only — no client code writes to pins today,
    //     but this blocks tampering with someone else's active pin.
    match /sync_pins/{pin} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.syncKey is string
                    && request.resource.data.expiresAt is number;

      allow get: if request.auth != null
                 && (!('expiresAt' in resource.data)
                     || resource.data.expiresAt > request.time.toMillis());

      allow list: if false;

      allow update, delete: if request.auth != null
                            && resource.data.ownerUid == request.auth.uid;
    }

    // ─── Legacy sync_keys: Permanently denied ────────────────────────────────
    // The old sync_keys collection is no longer used. Deny all access.
    match /sync_keys/{key} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write, delete: if false;
      }
    }
  }
}
