rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Per-user custom question bank blob (customQuestions.lz) —
    // only the authenticated owner may read or write their own file.
    match /user_qbank/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Everything else is denied by default.
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
